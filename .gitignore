# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.env
venv/
.venv/
.pytest_cache/
.ruff_cache/

# Datos generados (grandes binarios o efímeros)
data/charts/*.png
data/mensajes/
# Salida del escaner de tandas: un JSON por corrida, con el ranking y el motivo
# de cada exclusion. Es evidencia de una jornada, no fuente: se regenera corriendo
# el escaner, y versionarla llenaria el repo de snapshots de mercado.
data/screener/
# Directorio de trabajo del carrusel: payloads intermedios de una tanda, con su
# copia del ranking. Se regenera con --preparar; la pieza final vive en
# data/stories/, que tambien esta ignorado.
data/carrusel/
# Directorio de trabajo del informe: markdown intermedio, datos crudos y el PDF
# compilado. Se regenera con --preparar.
data/informes/
# data/stories/ es salida generada completa, no solo los PNG: tambien caen ahi
# los payloads de trabajo y la carpeta _revision de rendir_todas.py. Los payloads
# que SI se versionan viven en tests/fixtures/stories/payloads/.
data/stories/
data/plan_hoy.json
data/datos_entregables.json
data/ultimo_analisis.json
data/ultimo_evento.json
data/mt5_command.json
data/mt5_response.json

# Pulse — estado de runtime efímero (changes/, specs/ y heuristics/ SÍ se versionan)
# El ledger sqlite vive en el volumen Docker pulse-gam-ledger (ver .claude/plugins/pulse/.mcp.json)
.pulse/state.sqlite
.pulse/state.sqlite-shm
.pulse/state.sqlite-wal
.pulse/audit.jsonl
.pulse/*.bak

# MQL5 compilado: el fuente .mq5 se versiona; el binario .ex5 (output del compilador) no
*.ex5

# MCP config real (tiene API keys — usar mcp_config.example.json como referencia)
mcp/mcp_config.json

# Código ajeno: flash_mcp pertenece a otro proyecto (Reporte Flash), ver issue #25
flash_mcp/

# Reglas locales de otro asistente (Antigravity) — no forman parte del repo
.antigravitycli/

# IDEs y OS
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store

# Claude Code settings locales
.claude/settings.local.json
data/cache/

# Brainstorming visual companion (superpowers)
.superpowers/

# Antigravity (AGY). Los workflows y las reglas SÍ se versionan: son la forma en
# que AGY ejecuta los comandos del proyecto, y si viven solo en una máquina, el
# resto del equipo clona el repo sin ellos. Lo que queda fuera es la config local
# del MCP, que lleva la ruta absoluta de cada quien — mismo criterio que
# mcp/mcp_config.json frente a mcp_config.example.json.
.agents/*
!.agents/workflows/
!.agents/rules/
!.agents/skills/
!.agents/mcp.example.json

# Assets de marca GI (logos y fondos originales, pesados y no editables aca)
templates/stories/assets/*.jpg

# Borradores de trabajo: payloads sueltos, scripts de una corrida, pruebas de
# encoding. Se conservan en local porque sirven mientras se itera, pero no son
# el proyecto — un repo que los incluye deja de mostrar qué es código y qué fue
# un experimento de una tarde.
scratch/
scratch_data.py
scripts/spanish_test.py

# Contador de envíos de WhatsApp (freno anti-baneo, estado local)
data/.whatsapp_envios.json

# Sesión persistente de WhatsApp Web (Playwright) — resguardo de credenciales y tokens
.whatsapp_session/
data/.whatsapp_session/

# Trabajo antiguo archivado a mano: son cientos de MB de mensajes y stories ya
# emitidos. No aportan al repo y un `git add .` distraido los subiria enteros.
data/old/

# Artefactos generados dentro de la data lake (PDFs, PNG e informes compilados).
# Se regeneran con sus scripts; versionarlos infla el repo sin dar nada a cambio.
data central/**/reportes_generados/

# Series OHLC intradia y diarias: las regenera `scripts/extractor_precios.py`
# desde MT5 (10.000 velas por simbolo, ~5 MB cada una). Versionarlas sumaba ~66 MB
# por ingesta a la historia del repo sin aportar nada que MT5 no devuelva. Se
# conservan versionadas las semanales y `latest_prices_summary.json`, que son
# livianas y sirven de referencia cuando no hay terminal.
data central/DATA PRECIOS OHLC/*_M15.json
data central/DATA PRECIOS OHLC/*_H1.json
data central/DATA PRECIOS OHLC/*_D1.json

# PDF del manual y su vista previa: los produce `scripts/compilar_manual_pdf.py`
# desde el markdown, que si se versiona.
docs/MANUAL_DE_OPERACIONES_TRADING_CUANTITATIVO_GI.pdf
docs/preview_portada.png
data/.reloj_disparos.json
