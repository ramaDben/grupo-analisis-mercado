# Credenciales para Ecosistema de Datos Macroeconómicos
# Duplicar este archivo como .env y rellenar con las claves correspondientes.

# FRED API (St. Louis Fed) - Registro gratuito en https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=tu_api_key_de_fred_aqui

# Banco Central de Chile (API BDE / SIETE) - Registro ante contacto_ws@bcentral.cl / https://si3.bcentral.cl/Siete/es/Siete/API
BCCH_USER=tu_usuario_si3_bcentral
BCCH_PASS=tu_password_si3_bcentral
