# Credenciales para Ecosistema de Datos Macroeconómicos
# Duplicar este archivo como .env y rellenar con las claves correspondientes.

# FRED API (St. Louis Fed) - Registro gratuito en https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=tu_api_key_de_fred_aqui

# Banco Central de Chile (API BDE / SIETE) - Registro ante contacto_ws@bcentral.cl / https://si3.bcentral.cl/Siete/es/Siete/API
BCCH_USER=tu_usuario_si3_bcentral
BCCH_PASS=tu_password_si3_bcentral

# MetaTrader 5 (opcional, pero recomendado para la corrida automatica del reloj).
# `mt5_client.connect()` lee estas cuatro claves. SIN ellas, se engancha al terminal
# que ya este corriendo y devuelve la cuenta de ESE terminal; si no hay ninguno
# abierto, llama a initialize() sin credenciales y puede quedar en otra cuenta. El
# 2026-09-06 eso devolvio la 51256 en vez de la 51492, y el latido de las 09:30
# corre justamente cuando nadie esta mirando. Rellenarlas lo vuelve determinista.
# La cuenta que el sistema espera se declara en config/cuenta_mt5.json.
MT5_LOGIN=numero_de_cuenta
MT5_PASSWORD=password_de_la_cuenta
MT5_SERVER=nombre_del_servidor_del_broker
MT5_PATH=C:\ruta\a\terminal64.exe
